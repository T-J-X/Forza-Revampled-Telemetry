# Cargo build output
/target/
**/target/
**/*.rs.bk
*.pdb

# Built binaries and archives never belong in git
*.exe
*.zip

# Generated 4K mockups (cargo run --release -p preview-export)
/mockups/

# Secrets and local environment
.env
.env.*

# Editors and OS clutter
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Temp files from an interrupted atomic save (fh6-core atomic_file)
*.tmp

# Tooling
node_modules/
.claude/settings.local.json

# Rust-only repo: skill eval fixtures (C/Python/shell) and the TS hook plugin stay local
.claude/skills/*/evals/
.agents/skills/*/evals/
.claude/skills/prompt-cache-control/

# asset-forge: scratch renders, generated bpy scripts and logs live in target/asset-forge (already
# ignored); Blender autosaves and any local ComfyUI model copies never belong in git
*.blend1
*.blend
__pycache__/
*.safetensors
*.ckpt
*.pth

# asset-forge 4K masters too large for git (rebuilt by `asset-forge build`)
/assets/_masters/
